{
  "$defs": {
    "RelationshipDimension": {
      "enum": [
        "familiarity",
        "trust",
        "affection",
        "attraction",
        "respect",
        "fear",
        "resentment",
        "dependency",
        "loyalty"
      ],
      "title": "RelationshipDimension",
      "type": "string"
    }
  },
  "additionalProperties": false,

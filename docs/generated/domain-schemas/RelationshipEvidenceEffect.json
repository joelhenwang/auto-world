    "source_attempt_ids": {
      "default": [],
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Source Attempt Ids",
      "type": "array"
    },
    "source_character_id": {
      "format": "uuid",
      "title": "Source Character Id",
      "type": "string"
    },
    "target_character_id": {
      "format": "uuid",
      "title": "Target Character Id",
      "type": "string"
    }
  },
  "required": [
    "effect_key",
    "justification",
    "source_character_id",
    "target_character_id",
    "dimension",
    "evidence_strength"

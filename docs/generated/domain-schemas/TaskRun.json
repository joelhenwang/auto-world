{
  "$defs": {
    "TaskState": {
      "description": "Operational task lifecycle states (Stage 0 surface for S0-ORCH-001).\n\nHandbook READY maps to ``pending``; LEASED maps to ``claimed``.\nRetry delay uses ``available_at`` rather than a separate WAITING_RETRY state.",
      "enum": [
        "pending",
        "claimed",
        "running",
        "succeeded",
        "failed",
        "dead_letter",
        "cancelled"
      ],
      "title": "TaskState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "attempt_count": {
      "default": 0,
      "minimum": 0,
      "title": "Attempt Count",
      "type": "integer"
    },
    "available_at": {
      "format": "date-time",
      "title": "Available At",
      "type": "string"
    },
    "completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed At"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "error_code": {
